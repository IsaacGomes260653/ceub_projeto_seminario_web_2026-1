# Copie para .env e ajuste. Nunca suba o .env para o repositório.
PORT=3333
# Segredo que assina os tokens JWT. Em produção, use um valor longo e aleatório.
JWT_SEGREDO=troque-este-segredo
# Chave de API que identifica o front-end autorizado.
API_KEY=ciranda-dev-key
# Origens liberadas no CORS, separadas por vírgula.
CORS_ORIGENS=http://localhost:5173,http://localhost:4173
# Arquivo do banco SQLite. Use :memory: para não gravar em disco.
BANCO=./dados/ciranda.sqlite
