# Copie para .env e ajuste. O arquivo .env nunca vai para o repositório.
# Em produção, os segredos ficam nas variáveis de ambiente da hospedagem.

# Segredo que assina o JWT. Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=troque-este-segredo
# Chave que identifica o front autorizado a falar com a API.
API_KEY=troque-esta-chave

# Origens que podem chamar a API pelo navegador, separadas por vírgula.
CORS_ORIGENS=http://localhost:5173,http://localhost:4173

# Banco SQLite. ":memory:" cria um banco descartável a cada vez que a API sobe.
# Para guardar os dados, aponte para um arquivo: BANCO=dados/ciranda.db
BANCO=:memory:
# Endereço usado pelos comandos do Prisma (migrate). Deve apontar para o mesmo arquivo de BANCO.
DATABASE_URL=file:./dados/ciranda.db

PORT=3333
TOKEN_EXPIRA_EM=30m
SESSAO_DIAS=7
LIMITE_POR_MINUTO=120
LIMITE_LOGIN_POR_MINUTO=10
